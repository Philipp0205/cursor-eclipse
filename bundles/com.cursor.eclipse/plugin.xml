<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
	<extension point="org.eclipse.ui.views">
		<category
			id="com.cursor.eclipse.category"
			name="Cursor"/>
		<view
			id="com.cursor.eclipse.chat.ChatView"
			name="Cursor"
			icon="icons/cursor-16.png"
			restorable="true"
			allowMultiple="true"
			category="com.cursor.eclipse.category"
			class="com.cursor.eclipse.chat.ChatView"/>
		<view
			id="com.cursor.eclipse.agents.AgentsView"
			name="Cursor Agents"
			icon="icons/cursor-16.png"
			restorable="true"
			allowMultiple="false"
			category="com.cursor.eclipse.category"
			class="com.cursor.eclipse.agents.AgentsView"/>
	</extension>

	<extension point="org.eclipse.ui.perspectives">
		<perspective
			id="com.cursor.eclipse.perspective"
			name="Cursor"
			icon="icons/cursor-16.png"
			class="com.cursor.eclipse.perspective.CursorPerspective"
			fixed="false"/>
	</extension>

	<extension point="org.eclipse.ui.commands">
		<category
			id="com.cursor.eclipse.commands.category"
			name="Cursor"/>
		<command
			id="com.cursor.eclipse.commands.newSession"
			name="New Cursor Session"
			categoryId="com.cursor.eclipse.commands.category"/>
		<command
			id="com.cursor.eclipse.commands.newAgent"
			name="New Parallel Cursor Agent"
			categoryId="com.cursor.eclipse.commands.category"/>
		<command
			id="com.cursor.eclipse.commands.connect"
			name="Connect Cursor Agent"
			categoryId="com.cursor.eclipse.commands.category"/>
		<command
			id="com.cursor.eclipse.commands.resumeSession"
			name="Resume Cursor Session"
			categoryId="com.cursor.eclipse.commands.category"/>
		<command
			id="com.cursor.eclipse.commands.disconnect"
			name="Disconnect Cursor Agent"
			categoryId="com.cursor.eclipse.commands.category"/>
		<command
			id="com.cursor.eclipse.commands.openPreferences"
			name="Cursor Preferences"
			categoryId="com.cursor.eclipse.commands.category"/>
		<command
			id="com.cursor.eclipse.commands.openReview"
			name="Review Cursor Changes"
			categoryId="com.cursor.eclipse.commands.category"/>
		<command
			id="com.cursor.eclipse.commands.openPreview"
			name="Open App Preview"
			categoryId="com.cursor.eclipse.commands.category"/>
		<command
			id="com.cursor.eclipse.commands.openAgentsDashboard"
			name="Open Cursor Agents Dashboard"
			categoryId="com.cursor.eclipse.commands.category"/>
		<command
			id="com.cursor.eclipse.commands.login"
			name="Sign in to Cursor"
			categoryId="com.cursor.eclipse.commands.category"/>
	</extension>

	<extension point="org.eclipse.ui.handlers">
		<handler
			commandId="com.cursor.eclipse.commands.newSession"
			class="com.cursor.eclipse.chat.handlers.NewSessionHandler"/>
		<handler
			commandId="com.cursor.eclipse.commands.newAgent"
			class="com.cursor.eclipse.chat.handlers.NewAgentHandler"/>
		<handler
			commandId="com.cursor.eclipse.commands.connect"
			class="com.cursor.eclipse.chat.handlers.ConnectHandler"/>
		<handler
			commandId="com.cursor.eclipse.commands.resumeSession"
			class="com.cursor.eclipse.chat.handlers.ResumeSessionHandler"/>
		<handler
			commandId="com.cursor.eclipse.commands.disconnect"
			class="com.cursor.eclipse.chat.handlers.DisconnectHandler"/>
		<handler
			commandId="com.cursor.eclipse.commands.openPreferences"
			class="com.cursor.eclipse.chat.handlers.OpenPreferencesHandler"/>
		<handler
			commandId="com.cursor.eclipse.commands.openReview"
			class="com.cursor.eclipse.chat.handlers.OpenReviewHandler"/>
		<handler
			commandId="com.cursor.eclipse.commands.openPreview"
			class="com.cursor.eclipse.chat.handlers.OpenPreviewHandler"/>
		<handler
			commandId="com.cursor.eclipse.commands.openAgentsDashboard"
			class="com.cursor.eclipse.chat.handlers.OpenAgentsDashboardHandler"/>
		<handler
			commandId="com.cursor.eclipse.commands.login"
			class="com.cursor.eclipse.chat.handlers.LoginHandler"/>
	</extension>

	<extension point="org.eclipse.ui.menus">
		<menuContribution locationURI="toolbar:com.cursor.eclipse.chat.ChatView">
			<command
				commandId="com.cursor.eclipse.commands.newAgent"
				icon="icons/new-session.png"
				tooltip="Open a parallel Cursor agent"
				style="push"/>
			<command
				commandId="com.cursor.eclipse.commands.newSession"
				tooltip="Start a new Cursor session"
				style="push"/>
		</menuContribution>
		<menuContribution locationURI="menu:com.cursor.eclipse.chat.ChatView">
			<command
				commandId="com.cursor.eclipse.commands.resumeSession"
				label="Resume session..."
				style="push"/>
			<command
				commandId="com.cursor.eclipse.commands.connect"
				label="Connect"
				style="push"/>
			<command
				commandId="com.cursor.eclipse.commands.login"
				label="Sign in..."
				style="push"/>
			<command
				commandId="com.cursor.eclipse.commands.disconnect"
				label="Disconnect"
				style="push"/>
			<separator name="cursor.separator" visible="true"/>
			<command
				commandId="com.cursor.eclipse.commands.openReview"
				label="Review changes..."
				style="push"/>
			<command
				commandId="com.cursor.eclipse.commands.openPreview"
				label="Open app preview..."
				style="push"/>
			<command
				commandId="com.cursor.eclipse.commands.openAgentsDashboard"
				label="Open cloud agents..."
				style="push"/>
			<separator name="cursor.tools.separator" visible="true"/>
			<command
				commandId="com.cursor.eclipse.commands.openPreferences"
				label="Preferences"
				style="push"/>
		</menuContribution>
		<menuContribution locationURI="toolbar:com.cursor.eclipse.agents.AgentsView">
			<command
				commandId="com.cursor.eclipse.commands.newAgent"
				icon="icons/new-session.png"
				tooltip="Open a new Cursor agent"
				style="push"/>
		</menuContribution>
	</extension>

	<extension point="org.eclipse.ui.preferencePages">
		<page
			id="com.cursor.eclipse.prefs"
			name="Cursor"
			class="com.cursor.eclipse.prefs.CursorPreferencePage"/>
	</extension>

	<extension point="org.eclipse.core.runtime.preferences">
		<initializer class="com.cursor.eclipse.prefs.PreferenceInitializer"/>
	</extension>
</plugin>
